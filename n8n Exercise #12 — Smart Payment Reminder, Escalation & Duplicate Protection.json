    {
      "parameters": {
        "jsCode": "// Get initiated date\nconst initiatedDate = new Date($json.initiated_date);\n\n// Get today's date\nconst today = new Date();\n\n// Validate initiated date\nif (isNaN(initiatedDate.getTime())) {\n  throw new Error(`Invalid initiated_date: ${$json.initiated_date}`);\n}\n\n// Compare dates only\ninitiatedDate.setHours(0, 0, 0, 0);\ntoday.setHours(0, 0, 0, 0);\n\n// Calculate days since initiated\nconst difference = today - initiatedDate;\n\nconst daysSinceInitiated = Math.floor(\n  difference / (1000 * 60 * 60 * 24)\n);\n\n// Get the reminder already sent\nconst currentReminder = (\n  $json.reminder_level || ''\n).trim().toUpperCase();\n\n// Determine which reminder should be sent now\nlet requiredReminder = '';\n\nif (daysSinceInitiated >= 14) {\n  requiredReminder = 'FINAL';\n} else if (daysSinceInitiated >= 7) {\n  requiredReminder = 'SECOND';\n} else if (daysSinceInitiated >= 3) {\n  requiredReminder = 'FIRST';\n}\n\n// Duplicate protection\nlet sendReminder = false;\n\nif (requiredReminder === 'FIRST' && currentReminder === '') {\n  sendReminder = true;\n}\n\nif (\n  requiredReminder === 'SECOND' &&\n  currentReminder !== 'SECOND' &&\n  currentReminder !== 'FINAL'\n) {\n  sendReminder = true;\n}\n\nif (\n  requiredReminder === 'FINAL' &&\n  currentReminder !== 'FINAL'\n) {\n  sendReminder = true;\n}\n\n// Return results\nreturn {\n  json: {\n    ...$json,\n    days_since_initiated: Math.max(0, daysSinceInitiated),\n    required_reminder: requiredReminder,\n    send_reminder: sendReminder\n  }\n};"
      },
