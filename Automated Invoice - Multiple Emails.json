      "parameters": {
        "jsCode": "const invoice = $('Convert content to json file').first().json;\nconst gmail = $('Gmail Trigger').first().json;\n\nreturn {\n  json: {\n    queue_id: `Q-${Date.now()}`,\n\n    gmail_message_id:\n      gmail.id ||\n      gmail.messageId ||\n      gmail.message_id ||\n      '',\n\n    sales_invoice_number:\n      invoice.sales_invoice_number || '',\n\n    invoice_date:\n      invoice['date of invoice'] || '',\n\n    supplier:\n      invoice.supplier || '',\n\n    customer:\n      invoice.customer || '',\n\n    total_amount:\n      invoice.total_amount || '',\n\n    currency:\n      invoice.currency || '',\n\n    po_number:\n      invoice.po_number || '',\n\n    received_at: new Date().toISOString(),\n\n    status: 'PENDING',\n\n    reviewed_at: ''\n  }\n};"
      },
