    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nif (rows.length === 0) {\n  return [];\n}\n\n// Normalize the STATUS column\nconst normalized = rows.map(item => ({\n  ...item,\n  normalizedStatus: String(item.json['STATUS'] || '')\n    .trim()\n    .toUpperCase()\n}));\n\n// Check if an invoice is already being reviewed\nconst inReview = normalized.find(\n  item => item.normalizedStatus === 'IN_REVIEW'\n);\n\n// If one invoice is already under review, do not send another\nif (inReview) {\n  return [];\n}\n\n// Get all pending invoices\nconst pending = normalized.filter(\n  item => item.normalizedStatus === 'PENDING'\n);\n\n// Stop if there are no pending invoices\nif (pending.length === 0) {\n  return [];\n}\n\n// Sort according to Time Received\n// Oldest invoice will be first\npending.sort((a, b) => {\n  return new Date(a.json['Time Received']) -\n         new Date(b.json['Time Received']);\n});\n\n// Return only the oldest pending invoice\nreturn [\n  {\n    json: pending[0].json\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
