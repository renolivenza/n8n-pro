        "jsCode": "// Get the incoming sales invoice number\n// from the Code node after the Gmail Trigger\nconst incomingInvoice = String(\n  $('Convert content to json file').first().json.sales_invoice_number ?? ''\n).trim();\n\n// Get all rows returned by Google Sheets\nconst masterfileRows = $input.all();\n\n// Check if the sales invoice number already exists\nconst exists = masterfileRows.some(item => {\n  const masterInvoice = String(\n    item.json['Sales Invoice Number'] ?? ''\n  ).trim();\n\n  return masterInvoice === incomingInvoice;\n});\n\n// Return TRUE or FALSE\nreturn [\n  {\n    json: {\n      sales_invoice_exists: exists\n    }\n  }\n];"
      },
